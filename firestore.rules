rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;

      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.regulationId == "M-B"
                    && request.resource.data.rosterLocked is bool
                    && request.resource.data.ownedPokemonIds is list
                    && request.resource.data.spinState is map
                    && request.resource.data.spinState.unusedPokemonIds is list
                    && request.resource.data.spinState.usedPokemonIds is list
                    && request.resource.data.spinState.currentTeamIds is list
                    && request.resource.data.spinState.cycleNumber is int
                    && request.resource.data.spinState.cycleNumber >= 1
                    && request.resource.data.spinState.totalSpins is int
                    && request.resource.data.spinState.totalSpins >= 0;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
